# AAP Gateway (new sandbox instance)
AAP_HOSTNAME=https://aap.sandbox329.opentlc.com
AAP_TOKEN=
AAP_VALIDATE_CERTS=false

# SSH key for demo EC2 instances
PROBE_SSH_KEY_PATH=./patching-loop.pem

# AWS (for dynamic inventory + EC2 provisioning/reset)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# Base AMI for patching loop EC2 instances
AWS_BASE_AMI_ID=
AWS_INSTANCE_TYPE=t3.micro
AWS_SUBNET_ID=
AWS_SECURITY_GROUP_ID=
AWS_KEY_PAIR_NAME=patching-loop

# Red Hat subscription (for Insights registration on fresh instances)
RH_ORG_ID=
RH_ACTIVATION_KEY=

# GitHub (repo for CaC project sync)
GITHUB_TOKEN=
GITHUB_REPO=crenwick93/ao-summit-connect-patching-loop

# ServiceNow PDI
SERVICENOW_INSTANCE_URL=https://dev444518.service-now.com/
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=

# EDA Event Stream (for patching loop webhook)
EDA_EVENT_STREAM_URL='https://aap.sandbox329.opentlc.com/eda-event-streams/api/eda/v1/external_event_stream/<uuid>/post/'
EDA_EVENT_STREAM_TOKEN=

# AO EDA Trigger (OAuth2 service account credentials)
AO_WEBHOOK_BASE_URL=https://ao.sandbox329.opentlc.com
AO_WEBHOOK_PATH=
AO_WEBHOOK_CLIENT_ID=
AO_WEBHOOK_CLIENT_SECRET=
