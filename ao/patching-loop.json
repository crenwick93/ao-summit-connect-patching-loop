{
  "schema_version": "2.0.0",
  "name": "Patching Loop",
  "description": "Self-perpetuating patching loop: 9 EC2s in 3 rotating groups (A/B/C). Each cycle: assess fleet, fetch Lightspeed playbook, sync & deploy, create CR (approval gate for booth visitor), pre-check, run patch, post-check, close CR.",
  "triggers": [
    {
      "id": "trigger_eda",
      "type": "eda_trigger",
      "name": "Patching Loop (EDA)",
      "parameters": {
        "input_schema": {
          "type": "object",
          "properties": {
            "current_group": {
              "type": "string",
              "description": "Current group to patch: A, B, or C"
            }
          }
        },
        "webhook_path": "PLACEHOLDER_WEBHOOK_PATH",
        "authorized_service_account_ids": [
          "PLACEHOLDER_SERVICE_ACCOUNT_ID"
        ]
      },
      "position": {
        "x": 0,
        "y": 400
      }
    }
  ],
  "nodes": [
    {
      "id": "fleet_assessment",
      "type": "aap_job_template",
      "name": "Fleet Assessment",
      "parameters": {
        "diff_mode": false,
        "limit": "tag_group_${trigger.current_group}",
        "extra_vars": {
          "current_group": "${trigger.current_group}"
        },
        "credential_id": "beb79e87-9581-4447-873d-229755ea8a2b",
        "integration_id": "851d4bfd-6ccb-4b46-81ec-d1cc930b87ef",
        "job_template_name": "Loop - Fleet Assessment",
        "organization_name": "Default"
      },
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "fetch_and_commit",
      "type": "aap_job_template",
      "name": "Fetch Patching Playbook",
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "cve_id": "CVE-2021-4034",
          "current_group": "${trigger.current_group}",
          "target_hosts": "${fleet_assessment.artifacts.target_hosts}"
        },
        "credential_id": "beb79e87-9581-4447-873d-229755ea8a2b",
        "integration_id": "851d4bfd-6ccb-4b46-81ec-d1cc930b87ef",
        "job_template_name": "Loop - Fetch and Commit",
        "organization_name": "Default"
      },
      "position": {
        "x": 800,
        "y": 400
      }
    },
    {
      "id": "sync_and_deploy",
      "type": "aap_job_template",
      "name": "Sync & Deploy",
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "cve_id": "CVE-2021-4034",
          "current_group": "${trigger.current_group}",
          "target_hosts": "${fleet_assessment.artifacts.target_hosts}",
          "playbook_filename": "${fetch_and_commit.artifacts.playbook_filename}"
        },
        "credential_id": "beb79e87-9581-4447-873d-229755ea8a2b",
        "integration_id": "851d4bfd-6ccb-4b46-81ec-d1cc930b87ef",
        "job_template_name": "Loop - Sync and Deploy",
        "organization_name": "Default"
      },
      "position": {
        "x": 1200,
        "y": 400
      }
    },
    {
      "id": "create_cr",
      "type": "aap_job_template",
      "name": "Create Change Request",
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "action": "create",
          "current_group": "${trigger.current_group}",
          "target_hosts": "${fleet_assessment.artifacts.target_hosts}"
        },
        "credential_id": "beb79e87-9581-4447-873d-229755ea8a2b",
        "integration_id": "851d4bfd-6ccb-4b46-81ec-d1cc930b87ef",
        "job_template_name": "Loop - Manage Change Request",
        "organization_name": "Default"
      },
      "position": {
        "x": 1600,
        "y": 400
      }
    },
    {
      "id": "approval_gate",
      "type": "approval",
      "name": "Approve Patching",
      "parameters": {
        "prompt": "Booth visitor: click Implement in ServiceNow to approve patching for Group ${trigger.current_group}"
      },
      "position": {
        "x": 2000,
        "y": 400
      }
    },
    {
      "id": "precheck",
      "type": "aap_job_template",
      "name": "Pre-check",
      "parameters": {
        "limit": "tag_group_${trigger.current_group}",
        "diff_mode": false,
        "extra_vars": {
          "current_group": "${trigger.current_group}",
          "cr_sys_id": "${create_cr.artifacts.cr_sys_id}"
        },
        "credential_id": "beb79e87-9581-4447-873d-229755ea8a2b",
        "integration_id": "851d4bfd-6ccb-4b46-81ec-d1cc930b87ef",
        "job_template_name": "Loop - Pre-check",
        "organization_name": "Default"
      },
      "position": {
        "x": 2400,
        "y": 400
      }
    },
    {
      "id": "run_patch",
      "type": "aap_job_template",
      "name": "Run Patch",
      "parameters": {
        "limit": "tag_group_${trigger.current_group}",
        "diff_mode": false,
        "extra_vars": {
          "current_group": "${trigger.current_group}",
          "cr_sys_id": "${create_cr.artifacts.cr_sys_id}"
        },
        "credential_id": "beb79e87-9581-4447-873d-229755ea8a2b",
        "integration_id": "851d4bfd-6ccb-4b46-81ec-d1cc930b87ef",
        "job_template_name": "${sync_and_deploy.artifacts.template_name}",
        "organization_name": "Default"
      },
      "position": {
        "x": 2800,
        "y": 400
      }
    },
    {
      "id": "postcheck",
      "type": "aap_job_template",
      "name": "Post-check",
      "parameters": {
        "limit": "tag_group_${trigger.current_group}",
        "diff_mode": false,
        "extra_vars": {
          "current_group": "${trigger.current_group}",
          "cr_sys_id": "${create_cr.artifacts.cr_sys_id}"
        },
        "credential_id": "beb79e87-9581-4447-873d-229755ea8a2b",
        "integration_id": "851d4bfd-6ccb-4b46-81ec-d1cc930b87ef",
        "job_template_name": "Loop - Post-check",
        "organization_name": "Default"
      },
      "position": {
        "x": 3200,
        "y": 400
      }
    },
    {
      "id": "close_cr",
      "type": "aap_job_template",
      "name": "Close Change Request",
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "action": "close",
          "current_group": "${trigger.current_group}",
          "cr_sys_id": "${create_cr.artifacts.cr_sys_id}",
          "close_notes": "Patching loop cycle for Group ${trigger.current_group} complete. All checks passed."
        },
        "credential_id": "beb79e87-9581-4447-873d-229755ea8a2b",
        "integration_id": "851d4bfd-6ccb-4b46-81ec-d1cc930b87ef",
        "job_template_name": "Loop - Manage Change Request",
        "organization_name": "Default"
      },
      "position": {
        "x": 3600,
        "y": 400
      }
    }
  ],
  "edges": [
    {
      "from": "trigger_eda",
      "to": "fleet_assessment"
    },
    {
      "from": "fleet_assessment",
      "to": "fetch_and_commit"
    },
    {
      "from": "fetch_and_commit",
      "to": "sync_and_deploy"
    },
    {
      "from": "sync_and_deploy",
      "to": "create_cr"
    },
    {
      "from": "create_cr",
      "to": "approval_gate"
    },
    {
      "from": "approval_gate",
      "to": "precheck",
      "from_port": "approved"
    },
    {
      "from": "precheck",
      "to": "run_patch"
    },
    {
      "from": "run_patch",
      "to": "postcheck"
    },
    {
      "from": "postcheck",
      "to": "close_cr"
    }
  ]
}
